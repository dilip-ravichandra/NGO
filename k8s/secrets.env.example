# Copy to k8s/secrets.env (git-ignored) and fill in. Only these belong in the cluster.
# Do NOT copy your SUPABASE_ACCESS_TOKEN or service-role key here.
GROQ_API_KEY=
# Long random value: required to use the admin AI features on a server
ADMIN_API_TOKEN=
AUTH_SECRET=
# Your public address, e.g. https://www.yourdomain.org
ALLOWED_ORIGINS=
LLM_DAILY_CAP=3000
