# Copy this file to .env.local (git-ignored) and fill in your own keys. NEVER commit real keys.
# Production: set the same names as environment variables in your host (e.g. Vercel project settings).

# ---- AI providers (all optional except one) -------------------------------------------------
# Priority order. A provider is used only if its key is set. When one is rate-limited / down, the next answers.
LLM_PROVIDERS=groq
# LLM_PROVIDERS=groq,cerebras,gemini,openrouter,mistral

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b          # reads event posters (pictures)
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# Max AI calls per server instance per day. Protects your free quotas from abuse. Built-in answers take over after this.
# LLM_DAILY_CAP=3000

# ---- Security ---------------------------------------------------------------------------------
# REQUIRED on a public server: the admin-only AI endpoints (poster reader, ticket triage) refuse everything without this token.
# Use a long random value (e.g. 40+ characters). On your own computer (localhost) it is not needed.
# ADMIN_API_TOKEN=

# Only accept browser calls from your own site(s):
# ALLOWED_ORIGINS=https://yourdomain.org,https://www.yourdomain.org

# ---- Sign-in: real e-mail / SMS codes and Google ------------------------------------------------
# Long random text (40+ chars). REQUIRED on a public server: signs the one-time-code tickets.
# AUTH_SECRET=
# E-mail codes via Resend (https://resend.com). MAIL_FROM must be an address on a domain you verified there.
# RESEND_API_KEY=
# MAIL_FROM=Green India Gokul Foundation <no-reply@yourdomain.org>
# SMS codes via Twilio (https://twilio.com). Use either a number (TWILIO_FROM) or a Messaging Service.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=
# Google sign-in: the same Web client ID goes here AND in js/config.js (googleClientId).
# GOOGLE_CLIENT_ID=
# LOCAL TESTING ONLY: show the code on screen instead of sending it (works only from this computer).
# AUTH_DEV_ECHO=1
